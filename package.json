{
  "name": "parking-vehicle-manager",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "deploy:cloudflare": "npm run build && npx wrangler pages deploy dist --project-name parkingdb",
    "mac:dev": "vite build && electron electron/main.cjs",
    "mac:dist": "vite build && electron-builder --mac dmg"
  },
  "build": {
    "appId": "com.parking.vehicle.manager",
    "productName": "ParkingDBManager",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "mac": {
      "category": "public.app-category.business"
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.4",
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tesseract.js": "^7.0.0",
    "vite": "^6.3.2"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^26.0.12"
  }
}
